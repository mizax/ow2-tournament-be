SERVER_ADDR=127.0.0.1:8081
ACTIX_WORKERS=2

SQLITE.FILENAME=db.sqlite
SQLITE.TEXT_EXTENSION=./lib/text.dylib

APP.MAIN_HOST=http://localhost:5174
APP.ALT_HOST=http://localhost:5174

BATTLENET.CLIENT_ID=<client_id>
BATTLENET.CLIENT_SECRET=<client_secret>
BATTLENET.REDIRECT_URI=/auth/callback
BATTLENET.JWKS_URL=https://oauth.battle.net/jwks/certs

TWITCH.CLIENT_ID=<client_id>
TWITCH.CLIENT_SECRET=<client_secret>

STORAGE.ROOT_DIR=./storage
STORAGE.TYPE=file_system
STORAGE.SERVE_URL=http://localhost:8081
STORAGE.SHARD_LEVELS=2
